NODE_ENV = development
ENV_PROD = production
# Server configuration
PORT = 8027
HOST_NAME = localhost
# Database configuration
DB_USER =root
DB_PASSWORD = your_password
DB_NAME = restaurant_booking
DB_HOST = localhost
DB_PORT = 3306

# JWT configuration
ACCESS_TOKEN_SECRET = your_access_token_secret (a long random string)
REFRESH_TOKEN_SECRET = your_refresh_token_secret (a long random string)
ACCESS_TOKEN_MINUTES = your_access_token_life (vd: 30) 
REFRESH_TOKEN_DAYS = your_refresh_token_life (vd: 7)

# Zalo configuration
ZALO_APP_ID = your_zalo_app_id
ZALO_APP_SECRET = your_zalo_app_secret
ZALO_MINI_APP_ID = your_zalo_mini_app_id
ZALO_GRAPH_API_URL = https://graph.zalo.me/v2.0/me

# ========================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ========================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Gmail Credentials
SMTP_USER=youremail@gmail.com (email dùng để gửi)
SMTP_PASS=your app password (mật khẩu ứng dụng)

# Sender Info
SMTP_FROM="Restaurant Booking System <SMTP_USER>"
SMTP_FROM_NAME="Restaurant Booking System"

# Email Features
EMAIL_ENABLED=true
EMAIL_DEBUG=true

# Vercel configuration
VERCEL_URL=https://dine-link-dashboard.vercel.app