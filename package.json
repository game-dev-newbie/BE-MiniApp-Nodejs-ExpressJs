{
  "name": "project-mini_app",
  "version": "1.0.0",
  "description": "mini_app - restaurant booking",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "nodemon ./src/server.js",
    "dev": "nodemon ./src/server.js",
    "db:create": "node scripts/create-db.js",
    "db:drop": "node scripts/drop-db.js",
    "db:reset": "node scripts/reset-db.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage --coverageReporters=html",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**",
      "!src/migrations/**",
      "!src/seeders/**",
      "!src/server.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup/testSetup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "keywords": [
    "nodejs",
    "express",
    "miniapp-zalo"
  ],
  "author": "team-1",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "dayjs": "1.11.19",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "joi": "18.0.2",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "mysql2": "3.15.1",
    "node-cron": "4.2.1",
    "nodemailer": "7.0.11",
    "sequelize": "6.37.7",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@jest/globals": "30.2.0",
    "jest": "29.7.0",
    "morgan": "1.10.1",
    "nodemon": "3.1.10",
    "sequelize-cli": "6.6.3",
    "supertest": "7.1.4"
  }
}
